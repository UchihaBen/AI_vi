# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env

# ComfyUI chạy trên cùng server
COMFY_URL=http://127.0.0.1:8188

# TTS VieNeu
TTS_BASE_URL=https://api-tts.saokhue.io
TTS_API_KEY=

# LLM cho lệnh `plan` (bất kỳ API tương thích OpenAI: Ollama, vLLM, OpenRouter...)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:14b

# Token HuggingFace (chỉ cần nếu repo model yêu cầu đăng nhập)
HF_TOKEN=
